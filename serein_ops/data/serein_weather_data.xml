<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Seedability score at or above which a live fetch raises an alert (0 to 100). -->
        <record id="param_seedability_threshold" model="ir.config_parameter">
            <field name="key">serein_ops.seedability_threshold</field>
            <field name="value">60</field>
        </record>

        <record id="ir_cron_fetch_weather" model="ir.cron">
            <field name="name">Serein: fetch weather for every target area</field>
            <field name="model_id" ref="model_seeding_target_area"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_weather()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_expire_alerts" model="ir.cron">
            <field name="name">Serein: expire old cloud alerts</field>
            <field name="model_id" ref="model_seeding_cloud_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_alerts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
