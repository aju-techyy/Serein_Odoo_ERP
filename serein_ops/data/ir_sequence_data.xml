<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_seeding_contract" model="ir.sequence">
            <field name="name">Seeding Contract</field>
            <field name="code">seeding.contract</field>
            <field name="prefix">CTR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_seeding_cloud_alert" model="ir.sequence">
            <field name="name">Cloud Alert</field>
            <field name="code">seeding.cloud.alert</field>
            <field name="prefix">ALR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_seeding_mission" model="ir.sequence">
            <field name="name">Seeding Mission</field>
            <field name="code">seeding.mission</field>
            <field name="prefix">MSN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
