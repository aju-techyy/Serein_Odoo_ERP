<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The services a seeding contract invoices. Prices come from each
             contract (standby fee per day, flight-hour rate). -->
        <record id="product_seeding_standby_day" model="product.product">
            <field name="name">Seeding Standby Day</field>
            <field name="default_code">SRN-STANDBY</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_day"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="description_sale">Aircraft, crew, and flares on standby for the client's target areas during the season.</field>
        </record>

        <record id="product_seeding_flight_hour" model="product.product">
            <field name="name">Seeding Flight Hour</field>
            <field name="default_code">SRN-FLIGHT-HR</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="description_sale">Seeding flight time, from takeoff to landing.</field>
        </record>
    </data>
</odoo>
