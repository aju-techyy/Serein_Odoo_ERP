<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seeding_ai_log_view_list" model="ir.ui.view">
        <field name="name">seeding.ai.log.list</field>
        <field name="model">seeding.ai.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="outcome == 'failed'" decoration-warning="outcome == 'rejected'">
                <field name="create_date" string="Time"/>
                <field name="purpose"/>
                <field name="mission_id"/>
                <field name="alert_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="model_name" optional="show"/>
                <field name="duration" sum="Total"/>
                <field name="prompt_tokens" optional="hide" sum="Total"/>
                <field name="output_tokens" optional="hide" sum="Total"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'accepted'"
                       decoration-warning="outcome == 'rejected'"
                       decoration-danger="outcome == 'failed'"/>
                <field name="outcome_reason" optional="show"/>
            </list>
        </field>
    </record>

    <record id="seeding_ai_log_view_form" model="ir.ui.view">
        <field name="name">seeding.ai.log.form</field>
        <field name="model">seeding.ai.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="outcome" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="outcome == 'accepted'">
                        <field name="outcome_reason" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="purpose"/>
                            <field name="mission_id"/>
                            <field name="alert_id"/>
                            <field name="user_id"/>
                            <field name="create_date" string="Time"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="model_version"/>
                            <field name="http_status"/>
                            <field name="duration"/>
                            <field name="prompt_tokens"/>
                            <field name="output_tokens"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request" widget="code" options="{'mode': 'javascript'}" nolabel="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response" widget="code" options="{'mode': 'javascript'}" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="seeding_ai_log_view_search" model="ir.ui.view">
        <field name="name">seeding.ai.log.search</field>
        <field name="model">seeding.ai.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="mission_id"/>
                <field name="alert_id"/>
                <field name="model_name"/>
                <filter name="accepted" string="Accepted" domain="[('outcome', '=', 'accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('outcome', '=', 'rejected')]"/>
                <filter name="failed" string="Failed" domain="[('outcome', '=', 'failed')]"/>
                <separator/>
                <filter name="planning" string="Planning" domain="[('purpose', 'in', ('plan', 'replan'))]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
                    <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="seeding_ai_log_action" model="ir.actions.act_window">
        <field name="name">AI Activity</field>
        <field name="res_model">seeding.ai.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI calls yet</p>
            <p>Every call to the AI model is recorded here: what was sent, what came back,
               how long it took, and whether the answer was accepted.</p>
        </field>
    </record>
</odoo>
