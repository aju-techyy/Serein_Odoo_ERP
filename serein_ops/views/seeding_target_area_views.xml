<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seeding_target_area_view_list" model="ir.ui.view">
        <field name="name">seeding.target.area.list</field>
        <field name="model">seeding.target.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="radius_km"/>
                <field name="base_ids" widget="many2many_tags" optional="show"/>
                <field name="last_fetched_at" optional="show"/>
                <field name="last_score_band" column_invisible="1"/>
                <field name="last_score" optional="show"
                       decoration-success="last_score_band == 'seedable'" decoration-warning="last_score_band == 'marginal'"/>
            </list>
        </field>
    </record>

    <record id="seeding_target_area_view_form" model="ir.ui.view">
        <field name="name">seeding.target.area.form</field>
        <field name="model">seeding.target.area</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_weather" type="object" string="Fetch Now"
                            class="btn-primary" invisible="not id"
                            help="Fetch live conditions for this area from Open-Meteo and raise an alert if the score passes the threshold."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_snapshots" type="object" class="oe_stat_button" icon="fa-cloud">
                            <field name="snapshot_count" widget="statinfo" string="Snapshots"/>
                        </button>
                        <button name="action_view_alerts" type="object" class="oe_stat_button" icon="fa-bell">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Northern Highlands"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id" context="{'default_is_company': True}"/>
                            <field name="country_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Location">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="radius_km"/>
                            <field name="base_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Weather">
                            <field name="last_fetched_at"/>
                            <field name="last_score"/>
                            <field name="last_score_band" widget="badge" invisible="not last_fetched_at"
                                   decoration-success="last_score_band == 'seedable'" decoration-warning="last_score_band == 'marginal'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contracts" name="contracts">
                            <field name="contract_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="season_start"/>
                                    <field name="season_end"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'active'"
                                           decoration-muted="state in ('closed', 'cancelled')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="seeding_target_area_view_search" model="ir.ui.view">
        <field name="name">seeding.target.area.search</field>
        <field name="model">seeding.target.area</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="seeding_target_area_action" model="ir.actions.act_window">
        <field name="name">Target Areas</field>
        <field name="res_model">seeding.target.area</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first target area</p>
            <p>A target area is a region a client pays us to seed, given by its centre and radius.</p>
        </field>
    </record>
</odoo>
