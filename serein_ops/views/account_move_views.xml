<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_seeding" model="ir.ui.view">
        <field name="name">account.move.form.seeding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="after">
                <field name="seeding_contract_id" invisible="not seeding_contract_id"/>
                <field name="seeding_period_start" invisible="not seeding_contract_id"/>
                <field name="seeding_period_end" invisible="not seeding_contract_id"/>
            </xpath>
        </field>
    </record>
</odoo>
