<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seeding_base_view_list" model="ir.ui.view">
        <field name="name">seeding.base.list</field>
        <field name="model">seeding.base</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location_id"/>
                <field name="aircraft_count" string="Aircraft"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="seeding_base_view_form" model="ir.ui.view">
        <field name="name">seeding.base.form</field>
        <field name="model">seeding.base</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orderpoints" type="object" class="oe_stat_button"
                                icon="fa-refresh" invisible="not location_id"
                                groups="stock.group_stock_user">
                            <field name="orderpoint_count" widget="statinfo" string="Reorder Rules"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Coastal Airfield"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id" placeholder="Created automatically on save"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aircraft" name="aircraft">
                            <field name="aircraft_ids" readonly="1">
                                <list decoration-danger="service_status == 'grounded'"
                                      decoration-warning="service_status == 'due_soon'">
                                    <field name="name"/>
                                    <field name="tail_number"/>
                                    <field name="aircraft_type"/>
                                    <field name="rack_capacity"/>
                                    <field name="hours_since_service"/>
                                    <field name="service_status" widget="badge"
                                           decoration-success="service_status == 'ok'"
                                           decoration-warning="service_status == 'due_soon'"
                                           decoration-danger="service_status == 'grounded'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Target Areas Served" name="areas">
                            <field name="area_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="country_id"/>
                                    <field name="radius_km"/>
                                </list>
                            </field>
                        </page>
                        <page string="Crew" name="crew" groups="hr.group_hr_user">
                            <field name="crew_ids" readonly="1">
                                <list decoration-danger="flying_status == 'grounded'"
                                      decoration-warning="flying_status == 'expiring'">
                                    <field name="name"/>
                                    <field name="pilot_role"/>
                                    <field name="licence_expiry"/>
                                    <field name="medical_expiry"/>
                                    <field name="duty_hours_7d"/>
                                    <field name="flying_status" widget="badge"
                                           decoration-success="flying_status == 'ok'"
                                           decoration-warning="flying_status == 'expiring'"
                                           decoration-danger="flying_status == 'grounded'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="seeding_base_view_search" model="ir.ui.view">
        <field name="name">seeding.base.search</field>
        <field name="model">seeding.base</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="seeding_base_action" model="ir.actions.act_window">
        <field name="name">Bases</field>
        <field name="res_model">seeding.base</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first airbase</p>
            <p>A base is where aircraft are kept and flares are stocked.</p>
        </field>
    </record>
</odoo>
