<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_serein" model="res.groups.privilege">
        <field name="name">Serein</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_serein_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_serein"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees bases, target areas, contracts, and the fleet, and runs day-to-day seeding operations.</field>
    </record>

    <record id="group_serein_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_serein"/>
        <field name="implied_ids" eval="[
            (4, ref('group_serein_operator')),
            (4, ref('maintenance.group_equipment_manager')),
            (4, ref('hr.group_hr_user')),
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Also manages bases, target areas, contracts, aircraft, and pilots.</field>
    </record>

    <data noupdate="1">
        <!-- Standard users only see equipment they follow. Serein operators see every aircraft. -->
        <record id="rule_equipment_aircraft_operator" model="ir.rule">
            <field name="name">Serein operators see all aircraft</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[('is_aircraft', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_serein_operator'))]"/>
        </record>
    </data>
</odoo>
